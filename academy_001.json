    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst reject = (status, reason) => [{ json: { ok: false, status, reason } }];\nconst req = $input.first().json;\nconst headers = req.headers || {};\nconst body = req.body || {};\n\nlet secret = 'segredo-de-demonstracao-trocar';\ntry { if ($env.ACADEMY_001_SECRET) secret = $env.ACADEMY_001_SECRET; } catch (e) {}\n\nconst PRODUTOS = ['curso-demo-001', 'curso-demo-002'];\nconst EMAIL = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nfor (const campo of ['event_id', 'email', 'product', 'timestamp']) {\n  if (body[campo] === undefined || body[campo] === null || body[campo] === '') return reject(400, 'payload invalido: falta ' + campo);\n}\nif (!EMAIL.test(String(body.email))) return reject(400, 'payload invalido: email');\nif (!PRODUTOS.includes(String(body.product))) return reject(400, 'payload invalido: produto desconhecido');\n\nconst assinatura = String(headers['x-signature'] || '');\nconst canonica = [body.timestamp, body.event_id, body.email, body.product].join('.');\nconst esperada = crypto.createHmac('sha256', secret).update(canonica).digest('hex');\nconst a = Buffer.from(assinatura, 'utf8');\nconst b = Buffer.from(esperada, 'utf8');\nif (a.length !== b.length || !crypto.timingSafeEqual(a, b)) return reject(401, 'assinatura invalida');\n\nconst idade = Math.abs(Date.now() / 1000 - Number(body.timestamp));\nif (!(idade <= 300)) return reject(401, 'timestamp fora da janela de 5 minutos (replay)');\n\nconst store = $getWorkflowStaticData('global');\nstore.vistos = store.vistos || {};\nconst agora = Date.now();\nfor (const k of Object.keys(store.vistos)) { if (agora - store.vistos[k] > 86400000) delete store.vistos[k]; }\nif (store.vistos[body.event_id]) {\n  return [{ json: { ok: true, status: 200, duplicate: true, reason: 'evento ja processado', event_id: body.event_id } }];\n}\nstore.vistos[body.event_id] = agora;\nreturn [{ json: { ok: true, status: 200, duplicate: false, event_id: body.event_id, email: body.email, product: body.product } }];"
      },
